# Copy to .env (never commit .env). Values are issued by the Nexconn console / your mission administrator.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_REGION=sg
# signs console sessions (any long random string)
AEGIS_SESSION_SECRET=
# one personal access code per team member
AEGIS_CODE_OPS_COMMANDER=
AEGIS_CODE_FIELD_LEAD=
AEGIS_CODE_UAV_PILOT=
AEGIS_CODE_UGV_OPERATOR=
AEGIS_CODE_MEDICAL_LIAISON=
