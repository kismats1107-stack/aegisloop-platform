<?xml version="1.0"?>
<!-- AegisLoop scout drone. Gravity is disabled on the body and motion comes from
     the VelocityControl system (body-frame linear + angular velocity). This is a
     kinematic flight model: rotor aerodynamics are not simulated. -->
<sdf version="1.9">
  <model name="aegis_drone">
    <link name="base_link">
      <gravity>false</gravity>
      <inertial>
        <mass>1.6</mass>
        <inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="c">
        <geometry><box><size>0.34 0.34 0.10</size></box></geometry>
      </collision>
      <visual name="body">
        <geometry><box><size>0.30 0.22 0.10</size></box></geometry>
        <material><ambient>0.93 0.92 0.90 1</ambient><diffuse>0.93 0.92 0.90 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual>
      <!-- identity cap: drone violet -->
      <visual name="cap">
        <pose>0 0 0.055 0 0 0</pose>
        <geometry><box><size>0.20 0.14 0.02</size></box></geometry>
        <material><ambient>0.439 0.282 0.910 1</ambient><diffuse>0.439 0.282 0.910 1</diffuse></material>
      </visual>
      <visual name="arm_a">
        <pose>0 0 0.01 0 0 0.7854</pose>
        <geometry><box><size>0.62 0.035 0.025</size></box></geometry>
        <material><ambient>0.15 0.15 0.16 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
      </visual>
      <visual name="arm_b">
        <pose>0 0 0.01 0 0 -0.7854</pose>
        <geometry><box><size>0.62 0.035 0.025</size></box></geometry>
        <material><ambient>0.15 0.15 0.16 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
      </visual>
      <visual name="rotor_fl"><pose>0.22 0.22 0.035 0 0 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.008</length></cylinder></geometry>
        <material><ambient>0.25 0.25 0.27 0.8</ambient><diffuse>0.25 0.25 0.27 0.8</diffuse></material></visual>
      <visual name="rotor_fr"><pose>0.22 -0.22 0.035 0 0 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.008</length></cylinder></geometry>
        <material><ambient>0.25 0.25 0.27 0.8</ambient><diffuse>0.25 0.25 0.27 0.8</diffuse></material></visual>
      <visual name="rotor_rl"><pose>-0.22 0.22 0.035 0 0 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.008</length></cylinder></geometry>
        <material><ambient>0.25 0.25 0.27 0.8</ambient><diffuse>0.25 0.25 0.27 0.8</diffuse></material></visual>
      <visual name="rotor_rr"><pose>-0.22 -0.22 0.035 0 0 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.008</length></cylinder></geometry>
        <material><ambient>0.25 0.25 0.27 0.8</ambient><diffuse>0.25 0.25 0.27 0.8</diffuse></material></visual>

      <!-- Downward camera. Only renders when the world loads the Sensors system
           (build_world.py --camera). Streamed to the dashboard as proof-of-sim. -->
      <!-- camera sensor removed for the live Antakya world (keeps Gazebo fast enough for real-time-factor 8) -->
    </link>

    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/model/drone_1/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>drone_1</robot_base_frame>
      <odom_publish_frequency>20</odom_publish_frequency>
      <odom_topic>/model/drone_1/odometry</odom_topic>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
